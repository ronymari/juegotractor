{
  "name": "mision-tractor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env server/local.mjs",
    "build": "tsc -b && vite build",
    "build:local": "node scripts/build-local.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env server/local.mjs --production",
    "tunnel": ".tools/cloudflared.exe tunnel --url http://127.0.0.1:3001 --no-autoupdate --protocol http2",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.57.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.12",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "concurrently": "^9.2.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  }
}
