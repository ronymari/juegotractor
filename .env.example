# Producción en Vercel + Supabase. Las dos claves son públicas, nunca service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Ejemplos para la alternativa Supabase:
# VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR
# Desarrollo local: dejar las dos variables anteriores vacías.
# La clave del panel docente local es siempre: docente
# Para autoalojar Node + PostgreSQL embebido (NO Vercel):
# VITE_BACKEND=local
# PORT=3001
# PUBLIC_ORIGIN=https://tu-dominio.example
